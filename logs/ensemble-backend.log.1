ion="User preferences (e.g., preferred agents, constraints)"\n    )\n\nclass DecompositionResponse(BaseModel):\n    """Complete decomposition analysis and plan."""\n    request_id: str = Field(..., description="Unique request identifier")\n    analysis: TaskAnalysis = Field(..., description="Task analysis")\n    plan: DecompositionPlan = Field(..., description="Decomposition plan")\n    resource_estimate: ResourceEstimate = Field(..., description="Resource estimates")\n    allocation_plan: AllocationPlan = Field(..., description="Optimal allocation")\n    schedule: Schedule = Field(..., description="Execution schedule")\n    created_at: str = Field(default_factory=lambda: datetime.now().isoformat())\n\nclass PlanApprovalRequest(BaseModel):\n    """Request to approve/reject/modify a decomposition plan."""\n    request_id: str = Field(..., description="Request ID from decomposition")\n    action: str = Field(..., description="approve, reject, or modify")\n    modifications: Optional[Dict[str, Any]] = Field(\n        default=None,\n        description="Modifications to apply if action is \'modify\'"\n    )\n    reason: Optional[str] = Field(\n        default=None,\n        description="Reason for rejection or modification"\n    )\n\nclass PlanApprovalResponse(BaseModel):\n    """Response to plan approval."""\n    request_id: str\n    action: str\n    status: str\n    message: str\n    execution_started: bool = False\n    modified_plan: Optional[DecompositionPlan] = None\n\nclass HistoryRequest(BaseModel):\n    """Request for decomposition history."""\n    limit: int = Field(default=50, description="Max records to return")\n    status_filter: Optional[str] = Field(\n        default=None,\n        description="Filter by status (approved, rejected, executed)"\n    )\n\nclass HistoryResponse(BaseModel):\n    """Decomposition history response."""\n    decompositions: list = Field(..., description="Historical decompositions")\n    count: int = Field(..., description="Number of records returned")\n    accuracy_metrics: Dict[str, float] = Field(\n        default_factory=dict,\n        description="Historical accuracy metrics"\n    )\n\n\n# ============================================================================\n# In-Memory Storage for Demo\n# ============================================================================\n\n_decomposition_history: Dict[str, Dict[str, Any]] = {}\n\ndef store_decomposition(request_id: str, data: Dict[str, Any]):\n    """Store decomposition data."""\n    _decomposition_history[request_id] = {\n        **data,\n        "created_at": datetime.now().isoformat(),\n        "status": "pending"\n    }\n\ndef get_decomposition(request_id: str) -> Optional[Dict[str, Any]]:\n    """Get stored decomposition data."""\n    return _decomposition_history.get(request_id)\n\ndef update_decomposition_status(request_id: str, status: str, **kwargs):\n    """Update decomposition status and additional data."""\n    if request_id in _decomposition_history:\n        _decomposition_history[request_id]["status"] = status\n        _decomposition_history[request_id].update(kwargs)\n\ndef get_history(limit: int = 50, status_filter: Optional[str] = None) -> list:\n    """Get decomposition history."""\n    history = list(_decomposition_history.values())\n    \n    # Filter by status if provided\n    if status_filter:\n        history = [h for h in history if h.get("status") == status_filter]\n    \n    # Sort by creation time (newest first) and limit\n    history.sort(key=lambda x: x.get("created_at", ""), reverse=True)\n    return history[:limit]\n\n\n# ============================================================================\n# API Endpoint Functions\n# ============================================================================\n\nasync def decompose_task(request: DecompositionRequest) -> DecompositionResponse:\n    """\n    Analyze and decompose a user task into optimized sub-tasks.\n    \n    This is the main endpoint that:\n    1. Analyzes the user request\n    2. Decomposes into sub-tasks\n    3. Generates dependency graph\n    4. Estimates resources\n    5. Creates execution plan\n    """\n    try:\n        import uuid\n        request_id = str(uuid.uuid4())[:8]\n        \n        logger.info(f"Decomposing task: {request.user_request[:100]}...")\n        \n        engine = get_engine()\n        \n        # Step 1: Analyze the task\n        analysis = engine.analyze_task(request.user_request)\n        logger.info(f"Task analysis completed - Domain: {analysis.domain}")\n        \n        # Step 2: Decompose into sub-tasks\n        plan = engine.decompose_task(analysis)\n        logger.info(f"Task decomposed into {len(plan.sub_tasks)} sub-tasks")\n        \n        # Step 3: Estimate resources\n        resource_estimate = engine.estimate_resources(plan)\n        logger.info(f"Resource estimate: {resource_estimate.total_agents_needed} agents, ${resource_estimate.estimated_total_cost_usd}")\n        \n        # Step 4: Optimize allocation\n        allocation_plan = engine.optimize_allocation(plan)\n        logger.info(f"Allocation optimized into {allocation_plan.total_phases} phases")\n        \n        # Step 5: Generate schedule\n        schedule = engine.generate_execution_schedule(plan, allocation_plan)\n        logger.info(f"Schedule generated with {len(schedule.phases)} phases")\n        \n        # Store for approval workflow\n        store_decomposition(request_id, {\n            "request": request.dict(),\n            "analysis": analysis.dict(),\n            "plan": plan.dict(),\n            "resource_estimate": resource_estimate.dict(),\n            "allocation_plan": allocation_plan.dict(),\n            "schedule": schedule.dict()\n        })\n        \n        return DecompositionResponse(\n            request_id=request_id,\n            analysis=analysis,\n            plan=plan,\n            resource_estimate=resource_estimate,\n            allocation_plan=allocation_plan,\n            schedule=schedule\n        )\n        \n    except Exception as e:\n        logger.error(f"Decomposition failed: {e}")\n        raise HTTPException(status_code=500, detail=f"Decomposition failed: {str(e)}")\n\n\nasync def approve_plan(request: PlanApprovalRequest) -> PlanApprovalResponse:\n    """\n    Handle plan approval, rejection, or modification.\n    \n    Actions:\n    - approve: Start execution with the current plan\n    - reject: Mark as rejected with reason\n    - modify: Apply modifications and re-analyze\n    """\n    try:\n        # Get stored decomposition\n        decomp_data = get_decomposition(request.request_id)\n        if not decomp_data:\n            raise HTTPException(status_code=404, detail="Decomposition not found")\n        \n        if request.action == "approve":\n            # Mark as approved and ready for execution\n            update_decomposition_status(\n                request.request_id, \n                "approved",\n                approved_at=datetime.now().isoformat()\n            )\n            \n            return PlanApprovalResponse(\n                request_id=request.request_id,\n                action="approve",\n                status="approved",\n                message="Plan approved and ready for execution",\n                execution_started=False  # Would integrate with actual execution\n            )\n            \n        elif request.action == "reject":\n            # Mark as rejected\n            update_decomposition_status(\n                request.request_id, \n                "rejected",\n                rejected_at=datetime.now().isoformat(),\n                rejection_reason=request.reason\n            )\n            \n            return PlanApprovalResponse(\n                request_id=request.request_id,\n                action="reject",\n                status="rejected",\n                message=f"Plan rejected: {request.reason or \'No reason provided\'}"\n            )\n            \n        elif request.action == "modify":\n            # Apply modifications and re-decompose\n            if not request.modifications:\n                raise HTTPException(status_code=400, detail="Modifications required for modify action")\n            \n            # This is a simplified modification - in a full implementation,\n            # you would apply the modifications to the original request and re-decompose\n            update_decomposition_status(\n                request.request_id,\n                "modified",\n                modified_at=datetime.now().isoformat(),\n                modifications=request.modifications\n            )\n            \n            return PlanApprovalResponse(\n                request_id=request.request_id,\n                action="modify",\n                status="modified",\n                message="Plan modified successfully"\n            )\n            \n        else:\n            raise HTTPException(status_code=400, detail=f"Invalid action: {request.action}")\n            \n    except HTTPException:\n        raise\n    except Exception as e:\n        logger.error(f"Plan approval failed: {e}")\n        raise HTTPException(status_code=500, detail=f"Plan approval failed: {str(e)}")\n\n\nasync def get_decomposition_history(request: HistoryRequest) -> HistoryResponse:\n    """\n    Get decomposition history with accuracy metrics.\n    \n    Returns historical decompositions and calculates accuracy metrics\n    based on estimated vs actual execution times, costs, etc.\n    """\n    try:\n        history = get_history(request.limit, request.status_filter)\n        \n        # Calculate accuracy metrics\n        accuracy_metrics = _calculate_accuracy_metrics(history)\n        \n        return HistoryResponse(\n            decompositions=history,\n            count=len(history),\n            accuracy_metrics=accuracy_metrics\n        )\n        \n    except Exception as e:\n        logger.error(f"History retrieval failed: {e}")\n        raise HTTPException(status_code=500, detail=f"History retrieval failed: {str(e)}")\n\n\ndef _calculate_accuracy_metrics(history: list) -> Dict[str, float]:\n    """Calculate accuracy metrics from historical data."""\n    if not history:\n        return {}\n    \n    # In a real implementation, this would compare estimated vs actual metrics\n    # For now, return placeholder metrics\n    total_decompositions = len(history)\n    approved = len([h for h in history if h.get("status") == "approved"])\n    rejected = len([h for h in history if h.get("status") == "rejected"])\n    \n    return {\n        "approval_rate": approved / total_decompositions if total_decompositions > 0 else 0,\n        "rejection_rate": rejected / total_decompositions if total_decompositions > 0 else 0,\n        "avg_subtasks_per_request": sum(\n            len(h.get("plan", {}).get("sub_tasks", []))\n            for h in history\n        ) / total_decompositions if total_decompositions > 0 else 0,\n        "avg_estimated_duration_mins": sum(\n            h.get("plan", {}).get("total_estimated_duration_mins", 0)\n            for h in history\n        ) / total_decompositions if total_decompositions > 0 else 0\n    }\n\n\n# ============================================================================\n# FastAPI Integration Functions\n# ============================================================================\n\ndef register_decomposition_endpoints(app):\n    """\n    Register decomposition API endpoints with a FastAPI app.\n    \n    Usage:\n        from fastapi import FastAPI\n        from decomposition_api import register_decomposition_endpoints\n        \n        app = FastAPI()\n        register_decomposition_endpoints(app)\n    """\n    \n    @app.post("/api/decompose", response_model=DecompositionResponse)\n    async def decompose_endpoint(request: DecompositionRequest):\n        """Decompose a user task into optimized execution plan."""\n        return await decompose_task(request)\n 