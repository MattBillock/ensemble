 }\n    \n    return category_map.get(category, lambda: [])()\n\n\ndef get_family_names(category: NameCategory) -> List[str]:\n    """\n    Get all family names for a specific category.\n    \n    Args:\n        category: The NameCategory to retrieve family names for\n        \n    Returns:\n        List of family name strings\n    """\n    from . import fantasy, scifi, roman, gaming, creative\n    from ..name_generator import FAMILY_NAMES\n    \n    category_map = {\n        NameCategory.FANTASY: lambda: fantasy.FANTASY_FAMILY_NAMES,\n        NameCategory.SCIFI: lambda: scifi.SCIFI_FAMILY_NAMES,\n        NameCategory.ROMAN: lambda: roman.ROMAN_FAMILY_NAMES,\n        NameCategory.GAMING: lambda: gaming.GAMING_FAMILY_NAMES,\n        NameCategory.CREATIVE: lambda: creative.CREATIVE_FAMILY_NAMES,\n        NameCategory.CLASSIC: lambda: FAMILY_NAMES,\n    }\n    \n    return category_map.get(category, lambda: [])()\n\n\ndef get_all_first_names() -> Dict[NameCategory, List[str]]:\n    """\n    Get all first names organized by category.\n    \n    Returns:\n        Dictionary mapping NameCategory to list of first names\n    """\n    return {category: get_first_names(category) for category in NameCategory}\n\n\ndef get_all_family_names() -> Dict[NameCategory, List[str]]:\n    """\n    Get all family names organized by category.\n    \n    Returns:\n        Dictionary mapping NameCategory to list of family names\n    """\n    return {category: get_family_names(category) for category in NameCategory}\n\n\ndef get_category_stats() -> Dict[str, Dict[str, int]]:\n    """\n    Get statistics about each category\'s name counts.\n    \n    Returns:\n        Dictionary with category stats including first_names and family_names counts\n    """\n    stats = {}\n    for category in NameCategory:\n        first_names = get_first_names(category)\n        family_names = get_family_names(category)\n        stats[category.value] = {\n            "first_names": len(first_names),\n           