           # Create NEW tools with the spawned agent\'s permissions\\n851-            # This is critical - spawned agents need their own permission context\\n852-            spawned_tools = ToolRegistry.default(\\n853-                agent_definition=agent_definition,  # Use spawned agent\'s permissions!\\n854-                request_id=self.request_id,\\n855-                session_id=self.session_id,\\n856-                agent_id=spawned_agent_id\\n857-            )\\n858-\\n859-            # Add spawn capability to spawned agent\'s tools\\n860-            spawned_spawn_tool = SpawnAgentTool(\\n861-                agent_types_dir=self.agent_types_dir,\\n862-                api_key=self.api_key,\\n863-                tools=None,  # Will be set by child if needed\\n864-                budget_tier=self.budget_tier,\\n865-                parent_agent_id=spawned_agent_id,\\n866-                request_id=self.request_id,\\n867-                session_id=self.session_id\\n868-            )\\n869-            spawned_tools.register(spawned_spawn_tool)\\n870-\\n871-            # Create runtime for the agent with budget tier and metrics parameters\\n872-            runtime = AgentRuntime(\\n873-                agent_definition,\\n874-                api_key=self.api_key,\\n875-                tools=spawned_tools,  # Use the spawned agent\'s tools with correct permissions\\n876-                budget_tier=self.budget_tier,\\n877-                agent_id=spawned_agent_id,\\n878-                request_id=self.request_id,\\n879-                parent_agent_id=self.parent_agent_id,\\n880-                session_id=self.session_id  # Pass session ID for swarm state tracking\\n881-            )\\n882-\\n883-            # Execute the agent\\n884-            result = runtime.execute(input_data)\\n885-\\n886-            # Increment parent\'s spawned agents count (if parent runtime exists)\\n887-            # This would need to be tracked differently in a real implementation\\n888-\