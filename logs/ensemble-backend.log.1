capability matrix for the Ensemble system.\\\\\\\\n\\\\\\\\n## Hierarchy Overview\\\\\\\\n\\\\\\\\n```\\\\\\\\n                                    USER\\\\\\\\n                                      \\\\\\\\u2502\\\\\\\\n                                      \\\\\\\\u25bc\\\\\\\\n                        \\\\\\\\u250c\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2510\\\\\\\\n                        \\\\\\\\u2502     EXECUTIVE DIRECTOR      \\\\\\\\u2502\\\\\\\\n                        \\\\\\\\u2502  (leadership/executive_dir) \\\\\\\\u2502\\\\\\\\n                        \\\\\\\\u2502  can_write_code: false      \\\\\\\\u2502\\\\\\\\n                        \\\\\\\\u2502  can_write_tests: false     \\\\\\\\u2502\\\\\\\\n                        \\\\\\\\u2514\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u252c\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2518\\\\\\\\n                                      \\\\\\\\u2502\\\\\\\\n                    \\\\\\\\u250c\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u253c\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500\\\\\\\\u2500