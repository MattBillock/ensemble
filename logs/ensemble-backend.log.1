 = BackendCoordinatorErrorHandler(max_retries=3, base_delay=0.1)\n\n    def test_circuit_breaker_error_retry(self):\n        @self.error_handler.handle_circuit_breaker_error\n        def mock_circuit_breaker_operation():\n            raise CircuitBreakerOpenError("Service temporarily unavailable")\n\n        with self.assertRaises(CircuitBreakerOpenError):\n            mock_circuit_breaker_operation()\n\n    @patch(\'time.sleep\', return_value=None)\n    def test_rate_limit_error_backoff(self, mock_sleep):\n        @self.error_handler.handle_rate_limit_error\n        def mock_rate_limited_operation():\n            raise RateLimitError("Too many requests")\n\n        with self.assertRaises(RateLimitError):\n            mock_rate_limited_operation()\n\n        # Verify exponential backoff is applied\n        expected_sleep_calls = [\n            unittest.mock.call(0.1),   # First attempt\n            unittest.mock.call(0.2),   # Second attempt\n            unittest.mock.call(0.4)    # Third attempt\n        ]\n        mock_sleep.assert_has_calls(expected_sleep_calls)\n\n    def test_error_handler_initialization(self):\n        self.assertEqual(self.error_handler.max_retries, 3)\n        self.assertEqual(self.error_handler.base_delay, 0.1)\n        self.assertIsNotNone(self.error_handler.logger)\n\nif __name__ == \'__main__\':\n    unittest.main()'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_01FuAXvUr4CvTZqVQCWgDWYN', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write test file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/test_backend_coordinator_error_handling.py\' but lacks can_write_tests permission. This agent is a supervisor/coordinator and should delegate to test writers."}'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'toolu_01Sgwdxa5Dnuu3P58S1p7sW7', 'name': 'git_commit', 'input': {'message': 'Add unit test