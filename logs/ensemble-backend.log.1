else:
    errors.append('Max Iterations section not found or malformed')

if errors:
    print('ERRORS FOUND:')
    for error in errors:
        print(f'- {error}')
    exit(1)
else:
    print('Syntax verification PASSED')
    print('All required sections present')
    print('Max iterations correctly set to 22')
""}
