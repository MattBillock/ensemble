factor: float = 2.0):\n        self.logger = logging.getLogger(\'ExecutiveDirectorErrorHandler\')\n        self.max_retries = max_retries\n        self.backoff_factor = backoff_factor\n        \n    def handle_bad_request(self, func: Callable) -> Callable:\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            try:\n                # Validate input parameters\n                self._validate_input(*args, **kwargs)\n                return func(*args, **kwargs)\n            except ValueError as e:\n                self.logger.error(f"Bad Request Error: {e}")\n                raise\n        return wrapper\n    \n    def handle_not_found(self, func: Callable, fallback: Optional[Callable] = None) -> Callable:\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            try:\n                return func(*args, **kwargs)\n            except FileNotFoundError as e:\n                self.logger.warning(f"Resource Not Found: {e}")\n                if fallback:\n                    return fallback(*args, **kwargs)\n                raise\n        return wrapper\n    \n    def circuit_breaker(self, func: Callable) -> Callable:\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            for attempt in range(self.max_retries):\n                try:\n                    return func(*args, **kwargs)\n                except Exception as e:\n                    self.logger.warning(f"Circuit Breaker - Attempt {attempt + 1}: {e}")\n                    if attempt == self.max_retries - 1:\n                        raise\n                    \n                    # Exponential backoff\n                    sleep_time = (self.backoff_factor ** attempt)\n                    time.sleep(sleep_time)\n        return wrapper\n    \n    def rate_limit_handler(self, max_calls: int = 5, period: float = 1.0) -> Callable:\n        call_times = []\n        \n        def decorator(func: Callable) -> Callable:\n            @wraps(func)\n            def wrapper(*args, **kwargs):\n                current_time = time.time()\n                \n                # Remove old call times\n                call_times[:] = [t for t in call_times if current_time - t < period]\n                \n                if len(call_times) >= max_calls:\n                    wait_time = period - (current_time - call_times[0])\n                    self.logger.warning(f"Rate limit reached. Waiting {wait_time} seconds.")\n                    time.sleep(wait_time)\n                \n                call_times.append(current_time)\n                return func(*args, **kwargs)\n            return wrapper\n        return decorator\n    \n    def _validate_input(self, *args, **kwargs):\n        """\n        Implement input validation logic\n        Raise ValueError if input is invalid\n        """\n        # Example validation (customize as needed)\n        for arg in args:\n            if arg is None:\n                raise ValueError("Input cannot be None")\n        \n        for key, value in kwargs.items():\n            if value is None:\n                raise ValueError(f"Keyword argument {key} cannot be None")\n\n# Example usage\nerror_handler = ExecutiveDirectorErrorHandler()\n\n@error_handler.handle_bad_request\n@error_handler.circuit_breaker\n@error_handler.rate_limit_handler(max_calls=3, period=1.0)\ndef example_method(param1, param2):\n    # Method implementation\n    print(f"Processing with {param1}, {param2}")\n    return True\n\ndef default_fallback(*args, **kwargs):\n    """Fallback method when primary method fails"""\n    logging.warning("Using fallback method")\n    return None'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_01V188177XYDxzfeqs7SgvZN', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write code file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/executive_director_error_handler.py\' but lacks can_