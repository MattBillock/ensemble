sections = [
    '# TDD Coordinator',
    '## Purpose',
    '## Max Iterations'
]

errors = []
for section in sections:
    if section not in content:
        errors.append(f'Missing section: {section}')

# Check max iterations value
max_iter_match = re.search(r'## Max Iterations\s*\n(\d+)', content)
if max_iter_match:
    value = max_iter_match.group(1)
    print(f'Max Iterations value: {value}')
    if value != '22':
