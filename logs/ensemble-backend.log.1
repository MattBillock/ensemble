Breaker Open Error (Attempt {attempt + 1}): {e}")\n                    \n                    # Exponential backoff\n                    delay = self.base_delay * (2 ** attempt)\n                    time.sleep(delay)\n                    \n                    # Optional: Add circuit breaker reset logic\n                    if attempt == self.max_retries - 1:\n                        self.logger.error(f"Failed to execute after {self.max_retries} attempts")\n                        raise\n            \n        return wrapper\n\n    def handle_rate_limit_error(self, func: Callable[..., Any]) -> Callable[..., Any]:\n        """\n        Decorator to handle RateLimitError with smart retry and backoff\n        \n        :param func: Function to be executed\n        :return: Wrapped function with error handling\n        """\n        def wrapper(*args, **kwargs):\n            for attempt in range(self.max_retries):\n                try:\n                    return func(*args, **kwargs)\n                except RateLimitError as e:\n                    # Log the rate limit error\n                    self.logger.warning(f"Rate Limit Error (Attempt {attempt + 1}): {e}")\n                    \n                    # Dynamic backoff with jitter to prevent thundering herd\n                    delay = min(\n                        self.base_delay * (2 ** attempt),  # Exponential backoff\n                        e.suggested_wait_time if hasattr(e, \'suggested_wait_time\') else None or 30  # Respect API suggested wait\n                    )\n                    \n                    # Add randomness to prevent synchronization\n                    delay *= (1 + random.random())\n                    time.sleep(delay)\n                    \n                    if attempt == self.max_retries - 1:\n                        self.logger.error(f"Failed to execute after {self.max_retries} attempts")\n                        raise\n            \n        return wrapper\n\nclass CircuitBreakerOpenE