         except BadRequestError as e:\n                        attempts += 1\n                        logging.warning(f"BadRequestError on attempt {attempts}: {e}")\n                        if attempts >= max_attempts:\n                            logging.error(f"Max retry attempts reached for {func.__name__}")\n                            raise\n                        time.sleep(current_backoff)\n                        current_backoff *= 2  # Exponential backoff\n                    except CircuitBreakerOpenError as e:\n                        logging.error(f"Circuit Breaker Open: {e}")\n                        # Implement fallback or graceful degradation\n                        return None\n            return wrapper\n        return decorator\n\nclass BadRequestError(Exception):\n    """Custom exception for bad request errors"""\n    pass\n\nclass CircuitBreakerOpenError(Exception):\n    """Custom exception for circuit breaker open state"""\n    pass\n\nclass CircuitBreaker:\n    """Implementation of Circuit Breaker pattern"""\n    \n    def __init__(self, failure_threshold: int = 5, recovery_time: float = 30.0):\n        self.failures = 0\n        self.failure_threshold = failure_threshold\n        self.recovery_time = recovery_time\n        self.last_failure_time = None\n        self.state = "CLOSED"\n    \n    def __call__(self, func: Callable):\n        @wraps(func)\n        def wrapper(*args, **kwargs):\n            if self.state == "OPEN":\n                if time.time() - self.last_failure_time >= self.recovery_time:\n                    self.state = "HALF_OPEN"\n                else:\n                    raise CircuitBreakerOpenError("Circuit is currently open")\n            \n            try:\n                result = func(*args, **kwargs)\n                if self.state == "HALF_OPEN":\n                    self.state = "CLOSED"\n                    self.failures = 0\n                return result\n            except Exception as e:\n                self.failures += 1\n                self.last_failure_time = time.time()\n                \n                if self.failures >= self.failure_threshold:\n                    self.state = "OPEN"\n                    logging.error(f"Circuit breaker opened due to {self.failures} consecutive failures")\n                \n                raise\n        \n        return wrapper\n\n# Example usage\nclass UnitTestLead:\n    @ErrorHandler.retry(max_attempts=3)\n    @CircuitBreaker(failure_threshold=5, recovery_time=30.0)\n    def execute_test(self, test_case):\n        """\n        Sample method demonstrating error handling\n        \n        :param test_case: Test case to execute\n        :return: Test result\n        """\n        # Simulated test execution with potential errors\n        if not test_case:\n            raise BadRequestError("Invalid test case")\n        \n        # Actual test logic here\n        return "Test Executed Successfully"\n\n# Logging configuration\nlogging.basicConfig(\n    level=logging.INFO,\n    format=\'%(asctime)s - %(name)s - %(levelname)s - %(message)s\',\n    filename=\'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/error_handler.log\'\n)'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_01FqsMsxGtKwM7SuE53xB9Jt', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write code file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/error_handler.py\' but lacks can_write_code permission. This agent is a supervisor/coordinator and should delegate to code writers."}'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'toolu_01D615weXr18qELFwo387K6m', 'name': 'spawn_agent', 'input': {'agent_type': 'implementation_specialist', 'input_data': {'task': 'Create error handling implementation', 'project_id': '3ba10950', 'file_path': '/Users/mattbillock/Development/ai_exploration/ensemble/