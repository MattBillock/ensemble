ession_id) REFERENCES swarm_sessions(session_id),\\n                    FOREIGN KEY (parent_agent_id) REFERENCES agents(agent_id)\\n                );\\nCREATE INDEX idx_agents_session ON agents(session_id);\\nCREATE INDEX idx_agents_status ON agents(status);\\nCREATE INDEX idx_agents_parent ON agents(parent_agent_id);\\n", "stderr": ""}'}, {'type': 'tool_result', 'tool_use_id': 'toolu_01NzYztw7hM9VxCu9rLrdrqd', 'content': '{"success": true, "exit_code": 0, "stdout": "CREATE TABLE agent_executions (\\n                    id INTEGER PRIMARY KEY AUTOINCREMENT,\\n                    agent_id TEXT NOT NULL,\\n                    agent_type TEXT NOT NULL,\\n                    agent_name TEXT NOT NULL,\\n                    model_used TEXT NOT NULL,\\n                    task_complexity TEXT,\\n                    budget_tier TEXT,\\n                    success BOOLEAN NOT NULL,\\n                    error_type TEXT,\\n                    duration_ms INTEGER,\\n                    iterations INTEGER,\\n                    tokens_used INTEGER,\\n                    created_at TEXT NOT NULL,\\n                    completed_at TEXT,\\n                    request_id TEXT,\\n                    parent_agent_id TEXT,\\n                    spawned_agents_count INTEGER DEFAULT 0,\\n                    task_description TEXT,\\n                    self_analysis TEXT,\\n                    performance_analysis TEXT\\n                , input_tokens INTEGER, output_tokens INTEGER, estimated_cost REAL);\\nCREATE TABLE sqlite_sequence(name,seq);\\nCREATE INDEX idx_agent_type\\n                ON agent_executions(agent_type)\\n            ;\\nCREATE INDEX idx_model_used\\n                ON agent_executions(model_used)\\n            ;\\nCREATE INDEX idx_success\\n                ON agent_executions(success)\\n            ;\\nCREATE INDEX idx_created_at\\n                ON agent_executions(created_at)\\n            ;\\nCREATE INDEX idx_request_id\\n                ON agent_executions(re