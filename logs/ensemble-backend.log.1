it_error_handling(self, mock_sleep):\n        @DevelopmentManagerErrorHandler.handle_rate_limit_error\n        def mock_function():\n            raise RateLimitError("Rate limit exceeded")\n\n        result = mock_function()\n        mock_sleep.assert_called_once_with(60)\n        self.assertIsNotNone(result)\n\n    def test_error_logging_comprehensiveness(self):\n        # Verify logging captures sufficient error context\n        with self.assertLogs(level=\'ERROR\') as log_context:\n            @DevelopmentManagerErrorHandler.handle_bad_request_error\n            def error_logging_test():\n                raise BadRequestError("Comprehensive error logging test")\n\n            error_logging_test()\n        \n        self.assertTrue(any("Comprehensive error logging test" in record for record in log_context.records))\n\ndef main():\n    unittest.main()\n\nif __name__ == \'__main__\':\n    main()'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_019pjKv3t2px2bJ4u6FckdkS', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write test file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/development_manager_error_handling_test.py\' but lacks can_write_tests permission. This agent is a supervisor/coordinator and should delegate to test writers."}'}]}], 'model': 'claude-3-5-haiku-20241022', 'system': "You are a Executive Director agent.\n\n## Purpose\n\n\n## Instructions\n\n\n## Input Format\nYour input will be provided in the following format:\n```json\n{}\n```\n\n## Output Format\nYou must respond with JSON matching this exact format:\n```json\n{}\n```\n\n## When to Request Clarification\nRequest clarification when:\n\n\n## Termination Conditions\nYou are done when:\n\n\nCRITICAL: Your response must be valid JSON matching the Output Format exactly.\n\n## Your Performance History\n- Success rate: 52.5%\n- Average iterations per task: 12.5\n- Common e