SWatcher\') as mock_watcher:\n            yield mock_watcher\n\n    @pytest.fixture\n    def file_watcher(self, mock_chokidar):\n        """Create a FileWatcher instance for testing."""\n        return FileWatcher([\'/test/directory\'])\n\n    def test_initialization_sets_correct_watch_paths(self, file_watcher, mock_chokidar):\n        """Test that FileWatcher correctly initializes with specified paths."""\n        mock_chokidar.assert_called_once_with(\n            paths=[\'/test/directory\'], \n            ignored=pytest.helpers.ANY,\n            persistent=True\n        )\n\n    def test_file_creation_event_triggers_correct_metadata(self, file_watcher, mock_chokidar):\n        """Verify file creation event captures complete file metadata."""\n        # Arrange\n        mock_on_add = Mock()\n        file_watcher.on_file_added = mock_on_add\n        mock_file_path = \'/test/directory/new_file.txt\'\n        mock_stats = Mock()\n        mock_stats.st_size = 100\n        mock_stats.st_mtime = 1609459200  # Fixed timestamp\n\n        # Act\n        with patch(\'os.stat\', return_value=mock_stats), \\\n             patch(\'hashlib.md5\') as mock_md5:\n            mock_md5_instance = mock_md5.return_value\n            mock_md5_instance.hexdigest.return_value = \'test_checksum\'\n            \n            file_watcher._on_file_added(mock_file_path)\n\n        # Assert\n        mock_on_add.assert_called_once_with({\n            \'path\': mock_file_path,\n            \'type\': \'created\',\n            \'size\': 100,\n            \'timestamp\': 1609459200,\n            \'checksum\': \'test_checksum\'\n        })\n\n    def test_file_modification_event_captures_changes(self, file_watcher, mock_chokidar):\n        """Ensure file modification events are correctly processed."""\n        # Arrange\n        mock_on_change = Mock()\n        file_watcher.on_file_modified = mock_on_change\n        mock_file_path = \'/test/directory/existing_file.txt\'\n        mock_stats = Mock()\n        mock_stats.st_size = 250\n        mock_stats.st_mtime = 1609459300  # Updated timestamp\n\n        # Act\n        with patch(\'os.stat\', return_value=mock_stats), \\\n             patch(\'hashlib.md5\') as mock_md5:\n            mock_md5_instance = mock_md5.return_value\n            mock_md5_instance.hexdigest.return_value = \'updated_checksum\'\n            \n            file_watcher._on_file_modified(mock_file_path)\n\n        # Assert\n        mock_on_change.assert_called_once_with({\n            \'path\': mock_file_path,\n            \'type\': \'modified\',\n            \'size\': 250,\n            \'timestamp\': 1609459300,\n            \'checksum\': \'updated_checksum\'\n        })\n\n    def test_file_deletion_event_handling(self, file_watcher, mock_chokidar):\n        """Verify file deletion events are processed correctly."""\n        # Arrange\n        mock_on_delete = Mock()\n        file_watcher.on_file_deleted = mock_on_delete\n        mock_file_path = \'/test/directory/deleted_file.txt\'\n\n        # Act\n        file_watcher._on_file_deleted(mock_file_path)\n\n        # Assert\n        mock_on_delete.assert_called_once_with({\n            \'path\': mock_file_path,\n            \'type\': \'deleted\'\n        })\n\n    def test_error_handling_for_invalid_file_path(self, file_watcher):\n        """Test error handling when attempting to watch an invalid file path."""\n        # Arrange\n        with pytest.raises(ValueError, match="Invalid watch path"):\n            FileWatcher([\'/nonexistent/path\'])\n\n    def test_checksum_generation_for_large_files(self, file_watcher):\n        """Verify checksum generation handles large files efficiently."""\n        # Arrange\n        mock_file_path = \'/test/directory/large_file.bin\'\n        mock_stats = Mock()\n        mock_stats.st_size = 1024 * 1024 * 100  # 100 MB file\n\n        # Act\n        with patch(\'os.stat\', return_value=mock_stats), \\\n             patch(\'hashlib.md5\') as mock_md5, \\\n             patch(\'builtins.open\', mock_open()) as mock_file:\n            \n            mock_md5_instance = mock_md5.return_value\n            file_watcher._generate_checksum(mock_file_path)\n\n        # Assert\n        mock_md5.assert_called_once()\n        mock_md5_instance.update.assert_called()\n\n    def test_debounced_change_notification(self, file_watcher):\n        """Ensure multiple rapid file changes trigger a single notification."""\n        # Arrange\n        mock_on_change = Mock()\n        file_watcher.on_file_modified = mock_on_change\n        mock_file_path = \'/test/directory/rapidly_changing_file.txt\'\n\n        # Act\n        # Simulate multiple changes within debounce window\n        file_watcher._on_file_modified(mock_file_path)\n        file_watcher._on_file_modified(mock_file_path)\n        file_watcher._on_file_modified(mock_file_path)\n\n        # Assert\n        # Only one notification should be triggered due to debounce\n        assert mock_on_change.call_count == 1\n\n    def test_file_rename_event_handling(self, file_watcher):\n        """Verify behavior when a file is renamed."""\n        # Arrange\n        mock_on_renamed = Mock()\n        file_watcher.on_file_renamed = mock_on_renamed\n        old_path = \'/test/directory/old_name.txt\'\n        new_path = \'/test/directory/new_name.txt\'\n\n        # Act\n        file_watcher._on_file_renamed(old_path, new_path)\n\n        # Assert\n        mock_on_renamed.assert_called_once_with({\n            \'old_path\': old_path,\n            \'new_path\': new_path,\n            \'type\': \'renamed\'\n        })\n\n    def test_permission_change_detection(self, file_watcher):\n        """Test detection of file permission changes."""\n        # Arrange\n        mock_on_change = Mock()\n        file_watcher.on_file_modified = mock_on_change\n        mock_file_path = \'/test/directory/permission_file.txt\'\n        \n        # Simulate permission change\n        with patch(\'os.stat\') as mock_stat:\n            mock_stat.return_value.st_mode = 0o644  # Changed permissions\n            mock_stat.return_value.st_mtime = 1609459400\n\n            # Act\n            file_watcher._on_file_modified(mock_file_path)\n\n        # Assert\n        mock_on_change.assert_called_once_with(\n            pytest.helpers.dict_containing({\n                \'path\': mock_file_path,\n                \'type\': \'modified\'\n            })\n        )'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_01WzQadYqFFgvs6DY7WPcs9x', 'content': '{"success": false, "error": "[Errno 30] Read-only file system: \'/tests\'"}'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'toolu_019LJGSRfyeNwTUifu29vP7Q', 'name': 'run_command', 'input': {'command': 'mkdir -p /tests/field/ensemble_ui/backend'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_019LJGSRfyeNwTUifu29vP7Q', 'content': '{"success": false, "exit_code": 1, "stdout": "", "stderr": "mkdir: /tests: Read-only file system\\n"}'}]}], 'model': 'claude-3-5-haiku-20241022', 'system': 'You are a Unit Test Writer agent.\n\n## Purpose\nPrecision test writing tech. Writes failing unit tests that define requirements for code that doesn\'t exist yet. This is the first step in Test-Driven Development. Crisp, precise, catches mistakes.\n\n## Instructions\n**AUTHORITY**: You have FULL permission to CREATE test files that don\'t exist yet. If the test_file path doesn\'t exist, write_file will create it automatically.\n\n**JSON OUTPUT REQUIRED**: See [Common Instructions - JSON Output Format](/Users/mattbillock/Development/ai_exploration/ensemble/docs/common_instructions.md#json-output-format-requirement) - You MUST return valid JSON matching the Output Format schema above. NO conversational text.\n\n1. Read the task description carefully\n2. Identify what needs to be tested:\nMain functionality for this specific task\nEdge cases relevant to this task\nExpected inputs and outputs\n3. If existing_tests is provided, read it to understand context\n4. Write pytest tests that:\nHave clear, descriptive names (test_<what_it_tests>)\nInclude docstrings explaining what they verify\nTest ONE specific task/requirement\nAre expected to FAIL (code doesn\'t exist yet)\nFollow the Arrange-Act-Assert pattern\nUse appropriate assertions with clear failure messages\n5. Use write_file to save tests to the test file (creates file if it doesn\'t exist)\n6. Return list of test functions written\n7. **CRITICAL**: Do NOT run the tests - that\'s handled separately\n\n## Input Format\nYour input will be provided in the following format:\n```json\n{\n  "task_description": "string - specific task/requirement to test",\n  "test_file": "string - path where tests should be written",\n  "code_file": "string - path where code will be written (for import statements)",\n  "existing_tests": "string - content of existing tests to append to (optional)"\n}\n```\n\n## Output Format\nYou must respond with JSON matching this exact format:\n```json\n{\n  "status": "success|failure",\n  "test_file": "string - path to written test file",\n  "tests_written": "array - list of test function names written",\n  "message": "string - summary of what was tested",\n  "needs_clarification": "boolean - whether agent needs more info",\n  "clarification_question": "string - question for user if needs_clarification is true"\n}\n```\n\n## When to Request Clarification\nRequest clarification when:\n- Task description is too vague to write specific tests\n- Unclear what the expected behavior should be\n- Multiple valid interpretations of requirements exist\n- Missing information about inputs, outputs, or edge cases\n\n## Termination Conditions\nYou are done when:\n- Tests have been written to the test file\n- Tests capture all requirements for the current task\n- Tests are syntactically valid (but expected to fail since code doesn\'t exist yet)\n- Agent has confirmed tests match the requirements\n\nCRITICAL: Your response must be valid JSON matching the Output Format exactly.\n\n## Your Performance History\n- Success rate: 100.0%\n- Average iterations per task: 2.2\n\n**Tips for this run:**\n- Great work! Maintain your high performance standards.\n', 'tools': [{'name': 'write_file', 'description': 'Write content to a file, creating parent directories if needed. Automatically backs up existing files.', 'input_schema': {'type': 'object', 'properties': {'file_path': {'type': 'string', 'description': 'Path to the file to write'}, 'content': {'type': 'string', 'description': 'Content to write to the file'}}, 'required': ['file_path', 'content']}}, {'name': 'read_file', 'description': 'Read content from a file', 'input_schema': {'type': 'object', 'properties': {'file_path': {'type': 'string', 'description': 'Path to the file to read'}}, 'required': ['file_path']}}, {'name': 'run_command', 'description': 'Execute a shell command and return the output', 'input_schema': {'type': 'object', 'properties': {'command': {'type': 'string', 'description': 'The shell command to execute'}, 'working_directory': {'type': 'string', 'description': 'Optional working directory for command execution'}}, 'required': ['command']}}, {'name': 'git_commit', 'description': 'Commit changes to the git repository with a descriptive message', 'input_schema': {'type': 'object', 'properties': {'message': {'type': 'string', 'description': 'Commit message describing the changes'}, 'files': {'type': 'array', 'items': {'type': 'string'}, 'description': 'Optional list of specific files to commit. If not provided, commits all modified files.'}}, 'required': ['message']}}, {'name': 'git_branch', 'description': 'Create, switch, list, or delete git branches for coordinated development', 'input_schema': {'type': 'object', 'properties': {'action': {'type': 'string', 'enum': ['create', 'switch', 'list', 'delete', 'current'], 'description': 'Action to perform: create new branch, switch to existing, list all, delete, or get current'}, 'branch_name': {'type': 'string', 'description': 'Name of the branch (for create, switch, delete)'}, 'from_branch': {'type': 'string', 'description': 'Base branch to create from (for create, defaults to current branch)'}, 'force': {'type': 'boolean', 'description': 'Force the operation (for delete unmerged branches)', 'default': False}}, 'required': ['action']}}, {'name': 'git_merge', 'description': 'Merge branches or create pull requests for code review', 'input_schema': {'type': 'object', 'properties': {'action': {'type': 'string', 'enum': ['merge', 'preview', 'abort'], 'description': 'Action: merge branches, preview changes, or abort an in-progress merge'}, 'source_branch': {'type': 'string', 'description': 'Branch to merge from'}, 'target_branch': {'type': 'string', 'description': 'Branch to merge into (defaults to current branch)'}, 'strategy': {'type': 'string', 'enum': ['merge', 'squash', 'rebase'], 'description': 'Merge strategy (default: merge)', 'default': 'merge'}, 'message': {'type': 'string', 'description': 'Custom merge commit message (optional)'}, 'no_ff': {'type': 'boolean', 'description': 'Create merge commit even if fast-forward is possible', 'default': True}}, 'required': ['action']}}, {'name': 'git_status', 'description': 'Get comprehensive git repository status including branches, changes, and history', 'input_schema': {'type': 'object', 'properties': {'include_history': {'type': 'boolean', 'description': 'Include recent commit history', 'default': False}, 'history_count': {'type': 'integer', 'description': 'Number of commits to include in history', 'default': 10}}, 'required': []}}, {'name': 'project_tracking', 'description': 'Manage project state, tasks, and notes for the current project', 'input_schema': {'type': 'object', 'properties': {'action': {'type': 'string', 'enum': ['create_project', 'add_task', 'update_task', 'add_note', 'get_summary', 'get_next_tasks'], 'description': 'Action to perform'}, 'project_id':