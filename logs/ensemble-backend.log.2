 'name': 'write_file', 'input': {'file_path': '/frontend/src/components/__tests__/AchievementsDashboard.test.jsx', 'content': 'import React from \'react\';\nimport { render, screen, fireEvent } from \'@testing-library/react\';\nimport AchievementsDashboard from \'../AchievementsDashboard\';\n\n// Mock achievements dataset including famous_mustards\nconst mockAchievements = [\n  { name: \'Dijon Master\', category: \'famous_mustards\' },\n  { name: \'Productivity Streak\', category: \'productivity\' },\n  { name: \'Comedy Gold\', category: \'comedy\' },\n  { name: \'Mustard Connoisseur\', category: \'famous_mustards\' }\n];\n\ndescribe(\'AchievementsDashboard - Famous Mustards Category\', () => {\n  test(\'renders famous_mustards category in dropdown\', () => {\n    render(<AchievementsDashboard achievements={mockAchievements} />);\n    const famousMustardsOption = screen.getByText(/🥫 Famous Mustards/);\n    expect(famousMustardsOption).toBeInTheDocument();\n  });\n\n  test(\'filters achievements by famous_mustards category\', () => {\n    render(<AchievementsDashboard achievements={mockAchievements} />);\n    \n    // Select Famous Mustards category\n    const categorySelect = screen.getByRole(\'combobox\');\n    fireEvent.change(categorySelect, { target: { value: \'famous_mustards\' } });\n\n    // Check that only famous_mustards achievements are displayed\n    expect(screen.getByText(\'Dijon Master\')).toBeInTheDocument();\n    expect(screen.getByText(\'Mustard Connoisseur\')).toBeInTheDocument();\n    expect(screen.queryByText(\'Productivity Streak\')).not.toBeInTheDocument();\n  });\n\n  test(\'displays message when no achievements in category\', () => {\n    const emptyAchievements = [\n      { name: \'Productivity Streak\', category: \'productivity\' },\n      { name: \'Comedy Gold\', category: \'comedy\' }\n    ];\n\n    render(<AchievementsDashboard achievements={emptyAchievements} />);\n    \n    // Select Famous Mustards category\n    const categorySelect =