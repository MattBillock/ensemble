ne\n\nclass TestLocalClaudeProvider:\n    @pytest.fixture\n    def mock_provider(self):\n        # Will be replaced with actual implementation\n        pass\n\n    def test_cli_path_configuration(self):\n        """Verify CLI path can be configured"""\n        with patch(\'subprocess.run\') as mock_run:\n            mock_run.return_value = MagicMock(\n                returncode=0, \n                stdout=json.dumps({\n                    "type": "result",\n                    "result": "Test response",\n                    "usage": {"input_tokens": 10, "output_tokens": 20},\n                    "total_cost_usd": 0.0001\n                }).encode()\n            )\n            \n            # TODO: Implement LocalClaudeProvider with configurable CLI path\n            provider = None  # Replace with actual initialization\n            assert provider.cli_path is not None\n\n    def test_is_available_checks_cli_executable(self):\n        """Verify is_available method checks CLI executable status"""\n        with patch(\'subprocess.run\') as mock_run:\n            mock_run.return_value.returncode = 0\n            \n            # TODO: Implement LocalClaudeProvider\n            provider = None  # Replace with actual initialization\n            assert provider.is_available() is True\n\n    def test_basic_prompt_execution(self):\n        """Test basic prompt execution with subprocess"""\n        with patch(\'subprocess.run\') as mock_run:\n            mock_run.return_value = MagicMock(\n                returncode=0, \n                stdout=json.dumps({\n                    "type": "result",\n                    "result": "Claude says hello!",\n                    "usage": {"input_tokens": 15, "output_tokens": 25},\n                    "total_cost_usd": 0.0002\n                }).encode()\n            )\n            \n            # TODO: Implement LocalClaudeProvider\n            provider = None  # Replace with actual initialization\n            result = provider.execute("H