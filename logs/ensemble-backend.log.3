"message", ""),\n                "result_status": result.get("status", "unknown")\n            }\n            \n            # Store enhanced state\n            self._enhanced_agent_states[agent_id] = enhanced_state\n        \n        return activity\n    \n    def _safe_extract_deliverables(self, result: Dict[str, Any]) -> list:\n        """\n        Safely extract deliverables with type and length protection.\n        \n        Args:\n            result (Dict[str, Any]): Agent result dictionary\n        \n        Returns:\n            List of deliverables\n        """\n        deliverables = result.get("deliverables", [])\n        \n        # Ensure deliverables is a list\n        if not isinstance(deliverables, list):\n            deliverables = [str(deliverables)]\n        \n        # Limit to 10 deliverables, convert to strings\n        return [str(d) for d in deliverables[:10]]\n    \n    def get_agent_completion_summary(self, agent_id: str) -> Dict[str, Any]:\n        """\n        Retrieve enhanced completion summary for a specific agent.\n        \n        Args:\n            agent_id (str): Agent identifier\n        \n        Returns:\n            Dict with enhanced completion summary\n        """\n        # Check enhanced states first\n        if agent_id in self._enhanced_agent_states:\n            return self._enhanced_agent_states[agent_id]\n        \n        # Fallback to original tracker if no enhanced state\n        return {\n            "status": "unknown",\n            "completed_at": "",\n            "summary": "",\n            "self_analysis": "",\n            "deliverables": [],\n            "message": "",\n            "result_status": "unknown"\n        }\n    \n    def list_completed_agents(self) -> Dict[str, Dict[str, Any]]:\n        """\n        List all agents with completion summaries.\n        \n        Returns:\n            Dict of completed agents with their summaries\n        """\n        return {\n            agent_id: summary\n        