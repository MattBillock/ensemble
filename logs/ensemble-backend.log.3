tching mechanism\\n  test(\'toggleTheme should switch between light and dark themes\', () => {\\n    const { result } = renderHook(() => useTheme(), { \\n      wrapper: ({ children }) => (\\n        <ThemeProvider>{children}</ThemeProvider>\\n      )\\n    });\\n\\n    // Initial state check\\n    expect(result.current.theme).toBe(\'light\');\\n\\n    // Switch to dark theme\\n    act(() => {\\n      result.current.toggleTheme();\\n    });\\n\\n    expect(result.current.theme).toBe(\'dark\');\\n    expect(result.current.isDarkMode).toBe(true);\\n\\n    // Switch back to light theme\\n    act(() => {\\n      result.current.toggleTheme();\\n    });\\n\\n    expect(result.current.theme).toBe(\'light\');\\n    expect(result.current.isDarkMode).toBe(false);\\n  });\\n\\n  // Test theme persistence\\n  test(\'theme should persist across component re-renders\', () => {\\n    const TestComponent = () => {\\n      const { theme, toggleTheme } = useTheme();\\n      return (\\n        <div>\\n          <span data-testid=\\"current-theme\\">{theme}</span>\\n          <button onClick={toggleTheme}>Toggle Theme</button>\\n        </div>\\n      );\\n    };\\n\\n    const { getByTestId, getByText } = render(\\n      <ThemeProvider>\\n        <TestComponent />\\n      </ThemeProvider>\\n    );\\n\\n    // Initial theme check\\n    expect(getByTestId(\'current-theme\').textContent).toBe(\'light\');\\n\\n    // Toggle theme\\n    act(() => {\\n      getByText(\'Toggle Theme\').click();\\n    });\\n\\n    // Verify theme change persists\\n    expect(getByTestId(\'current-theme\').textContent).toBe(\'dark\');\\n  });\\n\\n  // Validate ThemeProvider component\\n  test(\'ThemeProvider should provide complete theme context\', () => {\\n    const TestConsumer = () => {\\n      const themeContext = useTheme();\\n      \\n      expect(themeContext).toHaveProperty(\'theme\');\\n      expect(themeContext).toHaveProperty(\'isDarkMode\');\\n      expect(themeContext).toHaveProperty(\'toggleTheme\');\\n      \\n      return null;\\n    };\\n\\n    render(\\n      <ThemeProvider>\\n        <TestConsumer />\\n      </ThemeProvider>\\n    );\\n  });\\n\\n  // Ensure correct context consumption\\n  test(\'multiple components can consume theme context simultaneously\', () => {\\n    const ComponentA = () => {\\n      const { theme } = useTheme();\\n      return <div data-testid=\\"component-a-theme\\">{theme}</div>;\\n    };\\n\\n    const ComponentB = () => {\\n      const { isDarkMode } = useTheme();\\n      return <div data-testid=\\"component-b-mode\\">{isDarkMode.toString()}</div>;\\n    };\\n\\n    const { getByTestId } = render(\\n      <ThemeProvider>\\n        <ComponentA />\\n        <ComponentB />\\n      </ThemeProvider>\\n    );\\n\\n    expect(getByTestId(\'component-a-theme\').textContent).toBe(\'light\');\\n    expect(getByTestId(\'component-b-mode\').textContent).toBe(\'false\');\\n  });\\n});"}'}]}], 'model': 'claude-opus-4-5-20251101', 'system': 'You are a  agent.\n\n## Purpose\n\n\n## Instructions\n\n\n## Input Format\nYour input will be provided in the following format:\n```json\n{}\n```\n\n## Output Format\nYou must respond with JSON matching this exact format:\n```json\n{}\n```\n\n## When to Request Clarification\nRequest clarification when:\n\n\n## Termination Conditions\nYou are done when:\n\n\nCRITICAL: Your response must be valid JSON matching the Output Format exactly.\n\n## Your Performance History\n- Success rate: 100.0%\n- Average iterations per task: 5.6\n\n**Tips for this run:**\n- Great work! Maintain your high performance standards.\n', 'tools': [{'name': 'write_file', 'description': 'Write content to a file, creating parent directories if needed. Automatically backs up existing files.', 'input_schema': {'type': 'object', 'properties': {'file_path': {'type': 'string', 'description': 'Path to the file to write'}, 'content': {'type': 'string', 'description': 'Content to write to the file'}}, 'required': ['file_path', 'content']}