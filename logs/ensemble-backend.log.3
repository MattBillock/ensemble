bled={isSubmitting || !problemInput}\\\\\\\\n                    style={{ width: \\\\\'100%\\\\\' }}\\\\\\\\n                  >\\\\\\\\n                    {isSubmitting ? (\\\\\\\\n                      <>\\\\\\\\n                        <Spinner animation=\\\\\\\\\\"border\\\\\\\\\\" size=\\\\\\\\\\"sm\\\\\\\\\\" className=\\\\\\\\\\"me-2\\\\\\\\\\" />\\\\\\\\n                        Starting...\\\\\\\\n                      </>\\\\\\\\n                    ) : (\\\\\\\\n                      \\\\\'\\\\\\\\ud83d\\\\\\\\ude80 Start Task\\\\\'\\\\\\\\n                    )}\\\\\\\\n                  </Button>\\\\\\\\n\\\\\\\\n                  {error && (\\\\\\\\n                    <Alert variant=\\\\\\\\\\"danger\\\\\\\\\\" className=\\\\\\\\\\"mt-3 mb-0\\\\\\\\\\" style={{ fontSize: \\\\\'12px\\\\\' }}>\\\\\\\\n                      {error}\\\\\\\\n                    </Alert>\\\\\\\\n                  )}\\\\\\\\n                </Form>\\\\\\\\n              </Card.Body>\\\\\\\\n            </Card>\\\\\\\\n\\\\\\\\n            {/* Pending Questions */}\\\\\\\\n            <PendingQuestions questions={questions} onAnswer={handleAnswerQuestion} />\\\\\\\\n\\\\\\\\n            {/* Agent Hierarchy */}\\\\\\\\n            <Card bg=\\\\\\\\\\"dark\\\\\\\\\\" text=\\\\\\\\\\"light\\\\\\\\\\">\\\\\\\\n              <Card.Header\\\\\\\\n                style={{ cursor: \\\\\'pointer\\\\\' }}\\\\\\\\n                onClick={() => toggleSection(\\\\\'hierarchy\\\\\')}\\\\\\\\n              >\\\\\\\\n                <div style={{ display: \\\\\'flex\\\\\', justifyContent: \\\\\'space-between\\\\\', alignItems: \\\\\'center\\\\\' }}>\\\\\\\\n                  <div>\\\\\\\\n                    <span style={{ marginRight: \\\\\'8px\\\\\' }}>\\\\\\\\n                      {sectionsCollapsed.hierarchy ? \\\\\'\\\\\\\\u25b6\\\\\' : \\\\\'\\\\\\\\u25bc\\\\\'}\\\\\\\\n                    </span>\\\\\\\\n                    <span style={{ fontSize: \\\\\'14px\\\\\' }}>Agent Hierarch