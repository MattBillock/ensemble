import sys
sys.path.append('/Users/mattbillock/Development/ai_exploration/ensemble/src/runtime/agents')
from achievements import ACHIEVEMENTS, AchievementCategory
from collections import Counter

# Count achievements by category
category_counts = Counter()
for achievement in ACHIEVEMENTS:
    category_counts[achievement.category.value] += 1

print('Current achievement distribution:')
for category in AchievementCategory:
    count = category_counts[category.value]
    print(f'{category.value}: {count} achievements')
print(f'\\nTotal achievements: {len(ACHIEVEMENTS)}')
