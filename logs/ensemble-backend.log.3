 base_delay: Base delay for exponential backoff\\\\n        \\"\\"\\"\\\\n        self.logger = logging.getLogger(__name__)\\\\n        self.max_retries = max_retries\\\\n        self.base_delay = base_delay\\\\n\\\\n    def handle_circuit_breaker_error(self, func: Callable[..., Any]) -> Callable[..., Any]:\\\\n        \\"\\"\\"\\\\n        Decorator to handle CircuitBreakerOpenError with retry and exponential backoff\\\\n        \\\\n        :param func: Function to be executed\\\\n        :return: Wrapped function with error handling\\\\n        \\"\\"\\"\\\\n        def wrapper(*args, **kwargs):\\\\n            for attempt in range(self.max_retries):\\\\n                try:\\\\n                    return func(*args, **kwargs)\\\\n                except CircuitBreakerOpenError as e:\\\\n                    # Log the error\\\\n                    self.logger.warning(f\\"Circuit Breaker Open Error (Attempt {attempt + 1}): {e}\\")\\\\n                    \\\\n                    # Exponential backoff\\\\n                    delay = self.base_delay * (2 ** attempt)\\\\n                    time.sleep(delay)\\\\n                    \\\\n                    # Optional: Add circuit breaker reset logic\\\\n                    if attempt == self.max_retries - 1:\\\\n                        self.logger.error(f\\"Failed to execute after {self.max_retries} attempts\\")\\\\n                        raise\\\\n            \\\\n        return wrapper\\\\n\\\\n    def handle_rate_limit_error(self, func: Callable[..., Any]) -> Callable[..., Any]:\\\\n        \\"\\"\\"\\\\n        Decorator to handle RateLimitError with smart retry and backoff\\\\n        \\\\n        :param func: Function to be executed\\\\n        :return: Wrapped function with error handling\\\\n        \\"\\"\\"\\\\n        def wrapper(*args, **kwargs):\\\\n            for attempt in range(self.max_retries):\\\\n                try:\\\\n                    return func(*args, **kwargs)\\\\n                except R