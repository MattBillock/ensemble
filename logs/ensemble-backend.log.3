tional, Any\n\n\ndef _detect_question(response_data: Dict[str, Any]) -> Optional[Dict[str, Any]]:\n    """\n    Detect if a response contains a question requiring clarification or user input.\n\n    Args:\n        response_data (Dict[str, Any]): Agent\'s response data dictionary\n\n    Returns:\n        Optional[Dict[str, Any]]: Question details or None if no question detected\n    """\n    # Check explicit status flags\n    needs_clarification = response_data.get(\'needs_clarification\', False)\n    needs_user_input = response_data.get(\'status\') == \'needs_user_input\'\n\n    # If no explicit flags, check for question-related fields\n    if not (needs_clarification or needs_user_input):\n        return None\n\n    # Extract question details\n    user_question = (\n        response_data.get(\'user_question\') or \n        response_data.get(\'clarification_question\') or \n        "Unspecified clarification needed"\n    )\n\n    # Generate unique question ID\n    question_id = f"q_{uuid.uuid4().hex[:8]}"\n\n    # Prepare question metadata\n    question_metadata = {\n        "question_id": question_id,\n        "text": user_question,\n        "type": "clarification" if needs_clarification else "user_input",\n        "options": response_data.get("options", []),\n        "context": {\n            key: value for key, value in response_data.items() \n            if key not in [\'needs_clarification\', \'status\', \'user_question\', \'clarification_question\', \'options\']\n        }\n    }\n\n    return {\n        "needs_clarification": needs_clarification,\n        "needs_user_input": needs_user_input,\n        "question_metadata": question_metadata\n    }'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_01LQCAr1WfdnnMsTjpw5btRB', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write code file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/runtime/agents/question_dete