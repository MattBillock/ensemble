ef __init__(self):\n        # Existing initialization\n        self.activities_by_request_id = {}\n        self.agent_states = {}\n\n    def record_agent_completed(\n        self,\n        agent_id: str,\n        agent_name: str,\n        request_id: str,\n        result: Optional[Dict[str, Any]] = None\n    ):\n        """\n        Record agent completion with enhanced summary extraction.\n        \n        Args:\n            agent_id (str): Unique identifier for the agent\n            agent_name (str): Name of the agent\n            request_id (str): Unique identifier for the request\n            result (Optional[Dict[str, Any]]): Result dictionary from agent execution\n        \n        Returns:\n            Optional activity record\n        """\n        # Existing activity recording logic\n        activity = self.activities_by_request_id.get(request_id)\n        if activity:\n            activity.status = "completed"\n            activity.end_time = datetime.now()\n\n        # Enhance agent_states with summary details\n        if agent_id in self.agent_states:\n            self.agent_states[agent_id]["status"] = "completed"\n            self.agent_states[agent_id]["completed_at"] = datetime.now().isoformat()\n            \n            # Extract key fields from result for UI display\n            if result:\n                # Safe extraction with default empty values\n                summary = result.get("summary", "")\n                self.agent_states[agent_id]["summary"] = summary[:500]  # Limit summary length\n                \n                self.agent_states[agent_id]["self_analysis"] = result.get("self_analysis", "")\n                \n                # Ensure deliverables is always a list\n                deliverables = result.get("deliverables", [])\n                if not isinstance(deliverables, list):\n                    deliverables = [str(deliverables)]\n                self.agent_states[agent_id]["deliverables"] = deliverables[:10]  # Limit to 10 deliverables\n                \n                # Additional metadata\n                self.agent_states[agent_id]["message"] = result.get("message", "")\n                self.agent_states[agent_id]["result_status"] = result.get("status", "unknown")\n        \n        return activity  # Maintain existing return behavior\n\n    def get_agent_completion_summary(self, agent_id: str) -> Dict[str, Any]:\n        """\n        Retrieve the completion summary for a specific agent.\n        \n        Args:\n            agent_id (str): Unique identifier for the agent\n        \n        Returns:\n            Dict with agent completion summary details\n        """\n        agent_state = self.agent_states.get(agent_id, {})\n        return {\n            "status": agent_state.get("status", ""),\n            "completed_at": agent_state.get("completed_at", ""),\n            "summary": agent_state.get("summary", ""),\n            "self_analysis": agent_state.get("self_analysis", ""),\n            "deliverables": agent_state.get("deliverables", []),\n            "message": agent_state.get("message", ""),\n            "result_status": agent_state.get("result_status", "")\n        }\n\n    def list_completed_agents(self) -> Dict[str, Dict[str, Any]]:\n        """\n        List all completed agents with their summaries.\n        \n        Returns:\n            Dict of completed agents with their summaries\n        """\n        return {\n            agent_id: self.get_agent_completion_summary(agent_id)\n            for agent_id, state in self.agent_states.items()\n            if state.get("status") == "completed"\n        }'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_01F1z7EM7JJJsQtAE2LzCxPy', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write code file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/runtime/agents/activity_tracker.py\' but lacks can_write_code permission. This a