nalysis\\": self_analysis,\\n                    \\"performance_analysis\\": performance_analysis\\n                }\\n                awarded = achievement_tracker.check_and_award(\\n                    agent_id=self.agent_id,\\n                    agent_name=self.definition.name,\\n                    agent_class=self.definition.name,\\n                    execution_data=execution_data\\n                )\\n                if awarded:\\n                    for achievement in awarded:\\n                        logger.info(f\\"Achievement unlocked for {self.definition.name}: {achievement.achievement_id}\\")\\n            except Exception as ae:\\n                logger.warning(f\\"Achievement check failed (non-critical): {ae}\\")\\n\\n        except Exception as e:\\n            logger.error(f\\"Failed to record metrics: {e}\\")\\n            # Don\'t re-raise - metrics recording should not break execution\\n\\n"}'}]}, {'role': 'assistant', 'content': [{'type': 'tool_use', 'id': 'toolu_015sEVMg14XoZyceGExFj96A', 'name': 'write_file', 'input': {'file_path': '/Users/mattbillock/Development/ai_exploration/ensemble/src/runtime/agents/runtime.py', 'content': '"""Agent runtime for executing agents with Anthropic API."""\n# Existing imports maintained...\n\n# Add these new imports\nimport uuid\n\n# Existing code remains the same until the AgentRuntime class definition\n\nclass AgentRuntime:\n    # Existing class attributes and methods remain the same...\n\n    def _detect_question(self, response_data: Dict[str, Any]) -> Optional[Dict[str, Any]]:\n        """\n        Detect if a response contains a question requiring clarification or user input.\n\n        Args:\n            response_data (Dict[str, Any]): Agent\'s response data dictionary\n\n        Returns:\n            Optional[Dict[str, Any]]: Question details or None if no question detected\n        """\n        # Check explicit status flags\n        needs_clarification = response_data.get(\'needs_clarification\', False)\n        needs_user_input = response_data.get(\'status\') == \'needs_user_input\'\n\n        # If no explicit flags, check for question-related fields\n        if not (needs_clarification or needs_user_input):\n            return None\n\n        # Extract question details\n        user_question = (\n            response_data.get(\'user_question\') or \n            response_data.get(\'clarification_question\') or \n            "Unspecified clarification needed"\n        )\n\n        # Generate unique question ID\n        question_id = f"q_{self.agent_id}_{uuid.uuid4().hex[:8]}"\n\n        # Prepare question metadata\n        question_metadata = {\n            "question_id": question_id,\n            "text": user_question,\n            "type": "clarification" if needs_clarification else "user_input",\n            "options": response_data.get("options", []),\n            "context": {\n                key: value for key, value in response_data.items() \n                if key not in [\'needs_clarification\', \'status\', \'user_question\', \'clarification_question\', \'options\']\n            }\n        }\n\n        return {\n            "needs_clarification": needs_clarification,\n            "needs_user_input": needs_user_input,\n            "question_metadata": question_metadata\n        }\n\n# Rest of the file remains the same...'}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_015sEVMg14XoZyceGExFj96A', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write code file \'/Users/mattbillock/Development/ai_exploration/ensemble/src/runtime/agents/runtime.py\' but lacks can_write_code permission. This agent is a supervisor/coordinator and should delegate to code writers."}'}]}], 'model': 'claude-3-5-haiku-20241022', 'system': "You are a Executive Director agent.\n\n## Purpose\n\n\n## Instructions\n\n\n## Input Format\nYour input will be provided in the following format:\n```json\n