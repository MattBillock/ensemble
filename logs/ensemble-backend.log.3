ry:\\\\n                    return func(*args, **kwargs)\\\\n                except CircuitBreakerOpenError as e:\\\\n                    # Log the error\\\\n                    self.logger.warning(f\\"Circuit Breaker Open Error (Attempt {attempt + 1}): {e}\\")\\\\n                    \\\\n                    # Exponential backoff\\\\n                    delay = self.base_delay * (2 ** attempt)\\\\n                    time.sleep(delay)\\\\n                    \\\\n                    # Optional: Add circuit breaker reset logic\\\\n                    if attempt == self.max_retries - 1:\\\\n                        self.logger.error(f\\"Failed to execute after {self.max_retries} attempts\\")\\\\n                        raise\\\\n            \\\\n        return wrapper\\\\n\\\\n    def handle_rate_limit_error(self, func: Callable[..., Any]) -> Callable[..., Any]:\\\\n        \\"\\"\\"\\\\n        Decorator to handle RateLimitError with smart retry and backoff\\\\n        \\\\n        :param func: Function to be executed\\\\n        :return: Wrapped function with error handling\\\\n        \\"\\"\\"\\\\n        def wrapper(*args, **kwargs):\\\\n            for attempt in range(self.max_retries):\\\\n                try:\\\\n                    return func(*args, **kwargs)\\\\n                except RateLimitError as e:\\\\n                    # Log the rate limit error\\\\n                    self.logger.warning(f\\"Rate Limit Error (Attempt {attempt + 1}): {e}\\")\\\\n                    \\\\n                    # Dynamic backoff with jitter to prevent thundering herd\\\\n                    delay = min(\\\\n                        self.base_delay * (2 ** attempt),  # Exponential backoff\\\\n                        e.suggested_wait_time if hasattr(e, \\\\\'suggested_wait_time\\\\\') else None or 30  # Respect API suggested wait\\\\n                    )\\\\n                    \\\\n                    # Add randomness to prevent synchronization\\\\n                    delay *= (1 + random.random())\\\\n                    time.sleep(delay)\\\\n                    \\\\n                    if attempt == self.max_retries - 1:\\\\n                        self.logger.error(f\\"Failed to execute after {self.max_retries} attempts\\")\\\\n                        raise\\\\n            \\\\n        return wrapper\\\\n\\\\nclass CircuitBreakerOpenError(Exception):\\\\n    \\"\\"\\"Custom exception for Circuit Breaker Open state\\"\\"\\"\\\\n    pass\\\\n\\\\nclass RateLimitError(Exception):\\\\n    \\"\\"\\"Custom exception for Rate Limiting\\"\\"\\"\\\\n    pass\\\\n\\\\n# Example usage\\\\nerror_handler = BackendCoordinatorErrorHandler()\\\\n\\\\n@error_handler.handle_circuit_breaker_error\\\\n@error_handler.handle_rate_limit_error\\\\ndef example_backend_operation():\\\\n    \\"\\"\\"\\\\n    Example backend operation with error handling\\\\n    \\"\\"\\"\\\\n    # Simulated backend operation\\\\n    try:\\\\n        # Perform critical backend task\\\\n        pass\\\\n    except Exception as e:\\\\n        # Wrap and re-raise with more context if needed\\\\n        raise\\\\n\\\\n# Logging configuration\\\\nlogging.basicConfig(\\\\n    level=logging.INFO,\\\\n    format=\\\\\'%(asctime)s - %(name)s - %(levelname)s - %(message)s\\\\\'\\\\n)\'}}]}, {\'role\': \'user\', \'content\': [{\'type\': \'tool_result\', \'tool_use_id\': \'toolu_016DfGrWd128Hf8CvbCDAZHx\', \'content\': \'{\\"success\\": false, \\"error\\": \\"ROGUE AGENT DETECTED: Agent \\\\\'Executive Director\\\\\' attempted to write code file \\\\\'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/backend_coordinator_error_handling.py\\\\\' but lacks can_write_code permission. This agent is a supervisor/coordinator and should delegate to code writers.\\"}\'}]}, {\'role\': \'assistant\', \'content\': [{\'type\': \'tool_use\', \'id\': \'toolu_0162E9muZBimUmysRoqdkhEi\', \'name\': \'spawn_agent\', \'input\': {\'agent_type\': \'code_writer\', \'input