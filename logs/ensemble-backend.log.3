 TaskDecomposition - %(levelname)s: %(message)s\\\\\'\\\\n        )\\\\n        self.logger = logging.getLogger(__name__)\\\\n\\\\n    def log_task_analysis(self, task_description: str, analysis: Dict[str, Any]):\\\\n        \\"\\"\\"Log detailed task analysis results\\"\\"\\"\\\\n        self.logger.info(f\\"Task Analysis: {task_description}\\")\\\\n        self.logger.debug(json.dumps(analysis, indent=2))\\\\n\\\\n    def log_resource_estimation(self, resource_estimate: Dict[str, Any]):\\\\n        \\"\\"\\"Log resource estimation details\\"\\"\\"\\\\n        self.logger.info(\\"Resource Estimation\\")\\\\n        self.logger.debug(json.dumps(resource_estimate, indent=2))\\\\n\\\\ndef validate_task_description(task_description: str) -> bool:\\\\n    \\"\\"\\"\\\\n    Validate the input task description\\\\n    \\\\n    Args:\\\\n        task_description (str): Task description to validate\\\\n    \\\\n    Returns:\\\\n        bool: Whether the task description is valid\\\\n    \\"\\"\\"\\\\n    if not task_description:\\\\n        return False\\\\n    \\\\n    # Basic validation rules\\\\n    min_length = 10\\\\n    max_length = 500\\\\n    \\\\n    return (\\\\n        len(task_description) >= min_length and \\\\n        len(task_description) <= max_length and\\\\n        task_description.strip() != \\\\\'\\\\\'\\\\n    )\\\\n\\\\ndef generate_task_signature(task_description: str) -> str:\\\\n    \\"\\"\\"\\\\n    Generate a unique signature for a task description\\\\n    \\\\n    Args:\\\\n        task_description (str): Task description\\\\n    \\\\n    Returns:\\\\n        str: Unique task signature\\\\n    \\"\\"\\"\\\\n    import hashlib\\\\n    return hashlib.md5(task_description.encode()).hexdigest()\\\\n\\\\ndef parallel_dependency_resolver(dependency_graph: nx.DiGraph) -> List[List[str]]:\\\\n    \\"\\"\\"\\\\n    Resolve parallel executable tasks from a dependency graph\\\\n    \\\\n    Args:\\\\n        dependency_graph (nx.DiGraph): Task dependency graph\\\\n    \\\\n    Returns:\\\\n        List[List[str]]: List of parallel task groups\\\\n    \\"\\"\\"\\\\n    parallel_groups = []\\\\n    remaining_nodes = set(dependency_graph.nodes())\\\\n    \\\\n    while remaining_nodes:\\\\n        # Find nodes with no dependencies in remaining set\\\\n        current_group = [\\\\n            node for node in remaining_nodes \\\\n            if all(dep not in remaining_nodes for dep in dependency_graph.predecessors(node))\\\\n        ]\\\\n        \\\\n        if not current_group:\\\\n            break\\\\n        \\\\n        parallel_groups.append(current_group)\\\\n        remaining_nodes -= set(current_group)\\\\n    \\\\n    return parallel_groups\\\\n\\\\ndef export_dependency_graph(graph: nx.DiGraph, output_file: str = \\\\\'dependency_graph.json\\\\\'):\\\\n    \\"\\"\\"\\\\n    Export dependency graph to a JSON file\\\\n    \\\\n    Args:\\\\n        graph (nx.DiGraph): Dependency graph to export\\\\n        output_file (str): Path to output JSON file\\\\n    \\"\\"\\"\\\\n    graph_data = {\\\\n        \\"nodes\\": list(graph.nodes()),\\\\n        \\"edges\\": list(graph.edges()),\\\\n        \\"node_count\\": graph.number_of_nodes(),\\\\n        \\"edge_count\\": graph.number_of_edges()\\\\n    }\\\\n    \\\\n    with open(output_file, \\\\\'w\\\\\') as f:\\\\n        json.dump(graph_data, f, indent=2)\\\\n\\\\n# Add more utility functions as needed for task decomposition\'}}]}, {\'role\': \'user\', \'content\': [{\'type\': \'tool_result\', \'tool_use_id\': \'toolu_015uPC2UibghVGgZN4hkBf9K\', \'content\': \'{\\"success\\": false, \\"error\\": \\"ROGUE AGENT DETECTED: Agent \\\\\'Executive Director\\\\\' attempted to write code file \\\\\'/Users/mattbillock/Development/ai_exploration/ensemble/src/field/ensemble_ui/output/utils.py\\\\\' but lacks can_write_code permission. This agent is a supervisor/coordinator and should delegate to code writers.\\"}\'}]}, {\'role\': \'assistant\', \'content\': [{\'type\': \'t