, 'description': 'Spawn and execute a specialist agent to perform a specific task', 'input_schema': {'type': 'object', 'properties': {'agent_type': {'type': 'string', 'description': "The type of agent to spawn (e.g., 'code_writer', 'code_tester')"}, 'input_data': {'type': 'object', 'description': 'Input data to pass to the spawned agent'}}, 'required': ['agent_type', 'input_data']}}]}}"}
