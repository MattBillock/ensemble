u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2518    \\u2502\\n\\u2502                                    \\u2502                                     \\u2502\\n\\u2502                                    \\u25bc                                     \\u2502\\n\\u2502  \\u250c\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2510    \\u2502\\n\\u2502  \\u2502                   DecompositionLearner                           \\u2502    \\u2502\\n\\u2502  \\u2502  decomposition_learner.py                                        \\u2502    \\u2502\\n\\u2502  \\u2502                                                                   \\u2502    \\u2502\\n\\u2502  \\u2502  Methods:                                                         \\u2502    \\u2502\\n\\u2502  \\u2502  - record_execution()                                             \\u2502    \\u2502\\n\\u2502  \\u2502  - improve_estimates() \\u2192 CalibrationReport                        \\u2502    \\u2502\\n\\u2502  \\u2502  - suggest_improvements()                                         \\u2502    \\u2502\\n\\u2502  \\u2502  - get_historical_accuracy() \\u2192 AccuracyMetrics                    \\u2502    \\u2502\\n\\u2502  \\u2514\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u