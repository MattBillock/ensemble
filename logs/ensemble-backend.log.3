mily-friendly content (no inappropriate words)\n      const inappropriateWords = ['damn', 'hell', 'stupid', 'dumb', 'crazy', 'insane'];\n      adjectives.forEach(word => {\n        expect(inappropriateWords.some(bad => word.toLowerCase().includes(bad))).toBe(false);\n        expect(typeof word).toBe('string');\n        expect(word.length).toBeGreaterThan(0);\n      });\n    });\n\n    test('nouns array contains at least 50 family-friendly words', () => {\n      expect(nouns).toBeDefined();\n      expect(Array.isArray(nouns)).toBe(true);\n      expect(nouns.length).toBeGreaterThanOrEqual(50);\n      \n      // Check for family-friendly content\n      const inappropriateWords = ['weapon', 'gun', 'knife', 'violence'];\n      nouns.forEach(word => {\n        expect(inappropriateWords.some(bad => word.toLowerCase().includes(bad))).toBe(false);\n        expect(typeof word).toBe('string');\n        expect(word.length).toBeGreaterThan(0);\n      });\n    });\n\n    test('descriptors array contains at least 50 family-friendly words', () => {\n      expect(descriptors).toBeDefined();\n      expect(Array.isArray(descriptors)).toBe(true);\n      expect(descriptors.length).toBeGreaterThanOrEqual(50);\n      \n      // Check for family-friendly content\n      const inappropriateWords = ['ugly', 'disgusting', 'horrible', 'awful'];\n      descriptors.forEach(word => {\n        expect(inappropriateWords.some(bad => word.toLowerCase().includes(bad))).toBe(false);\n        expect(typeof word).toBe('string');\n        expect(word.length).toBeGreaterThan(0);\n      });\n    });\n  });\n\n  describe('generateName function', () => {\n    test('returns a string', () => {\n      const name = generateName();\n      expect(typeof name).toBe('string');\n      expect(name.length).toBeGreaterThan(0);\n    });\n\n    test('returns 2-3 words separated by spaces', () => {\n      const name = generateName();\n      const words = name.trim().split(/\\s+/);\n      expect(words.length).toBeGreaterThanOrEqual(2);\n      expect(words.length).toBeLessThanOrEqual(3);\n      \n      // Each word should be non-empty\n      words.forEach(word => {\n        expect(word.length).toBeGreaterThan(0);\n      });\n    });\n\n    test('generates family-friendly names', () => {\n      // Generate multiple names to test\n      for (let i = 0; i < 20; i++) {\n        const name = generateName();\n        const inappropriateWords = ['damn', 'hell', 'stupid', 'dumb', 'weapon', 'gun', 'ugly'];\n        \n        inappropriateWords.forEach(badWord => {\n          expect(name.toLowerCase().includes(badWord)).toBe(false);\n        });\n      }\n    });\n\n    test('produces variety in outputs', () => {\n      const names = new Set();\n      const iterations = 50;\n      \n      for (let i = 0; i < iterations; i++) {\n        names.add(generateName());\n      }\n      \n      // Should have at least 80% unique names (allowing for some duplicates)\n      expect(names.size).toBeGreaterThan(iterations * 0.8);\n    });\n\n    test('uses words from the provided arrays', () => {\n      const name = generateName();\n      const words = name.toLowerCase().split(/\\s+/);\n      const allWords = [...adjectives, ...nouns, ...descriptors].map(w => w.toLowerCase());\n      \n      // At least one word should come from our arrays\n      const hasWordFromArrays = words.some(word => allWords.includes(word));\n      expect(hasWordFromArrays).toBe(true);\n    });\n\n    test('capitalizes first letter of each word', () => {\n      const name = generateName();\n      const words = name.split(/\\s+/);\n      \n      words.forEach(word => {\n        expect(word.charAt(0)).toBe(word.charAt(0).toUpperCase());\n      });\n    });\n  });\n});"}}]}, {'role': 'user', 'content': [{'type': 'tool_result', 'tool_use_id': 'toolu_016Jdm6EC3Er7wkBMuqzEK7D', 'content': '{"success": false, "error": "ROGUE AGENT DETECTED: Agent \'Executive Director\' attempted to write test file \'/Users/mattbillock/Development/ai_exploratio