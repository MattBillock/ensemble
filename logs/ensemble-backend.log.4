rate_dependency_graph() \\u2192 nx.DiGraph                      \\u2502    \\u2502\\n\\u2502  \\u2502  - estimate_resources() \\u2192 ResourceEstimate                        \\u2502    \\u2502\\n\\u2502  \\u2502  - optimize_allocation() \\u2192 AllocationPlan                         \\u2502    \\u2502\\n\\u2502  \\u2502  - generate_execution_schedule() \\u2192 Schedule                       \\u2502    \\u2502\\n\\u2502  \\u2514\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2518    \\u2502\\n\\u2502                                    \\u2502                                     \\u2502\\n\\u2502                                    \\u25bc                                     \\u2502\\n\\u2502  \\u250c\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2500\\u2510    \\u2502\\n\\u2502  \\u2502                   DecompositionLearner                           \\u2502    \\u2502\\n\\u2502  \\u2502  decomposition_learner.py                                        \\u2502    \\u2502\\n\\u2502  \\u2502                                                                   \\u2502    \\u2502\\n\\u2502  \\u2502  Methods:                                                         \\u2502    \\u