=> {\n    /**\n     * Verifies that generated names follow the 2-3 word format requirement\n     */\n    const name = generateName();\n    expect(typeof name).toBe('string');\n    expect(name.length).toBeGreaterThan(0);\n    \n    // Count words by splitting on common separators or capital letters\n    const wordCount = name.split(/[A-Z]/).length - 1 || name.split(/[-_\\s]/).length;\n    expect(wordCount).toBeGreaterThanOrEqual(2);\n    expect(wordCount).toBeLessThanOrEqual(3);\n  });\n\n  test('should generate different names on consecutive calls', () => {\n    /**\n     * Ensures the generator produces variety and doesn't repeat immediately\n     */\n    const names = [];\n    for (let i = 0; i < 10; i++) {\n      names.push(generateName());\n    }\n    \n    const uniqueNames = new Set(names);\n    // Should have at least 8 unique names out of 10 calls\n    expect(uniqueNames.size).toBeGreaterThanOrEqual(8);\n  });\n\n  test('should handle empty word pool gracefully', () => {\n    /**\n     * Tests error handling when word pool is empty\n     */\n    expect(() => generateName([])).toThrow('Cannot generate name from empty word pool');\n  });\n\n  test('should handle single word pool', () => {\n    /**\n     * Tests behavior with minimal word pool\n     */\n    const singleWordPool = ['lonely'];\n    expect(() => generateName(singleWordPool)).toThrow('Insufficient words to generate combined name');\n  });\n\n  test('should generate name with custom word pool', () => {\n    /**\n     * Verifies generator works with custom word pools\n     */\n    const customPool = ['red', 'blue', 'green', 'yellow', 'purple', 'orange'];\n    const name = generateName(customPool);\n    expect(typeof name).toBe('string');\n    expect(name.length).toBeGreaterThan(0);\n  });\n\n  test('should generate multiple names successfully', () => {\n    /**\n     * Tests batch name generation functionality\n     */\n    const names = generateMultipleNames(5);\n    expect(names).toHaveLength(5);\n    names.forEach(name => {\n      expect(typeof name).toBe('string');\n      expect(name.length).toBeGreaterThan(0);\n    });\n  });\n});\n\ndescribe('Name Generator - Content Appropriateness', () => {\n  test('all generated names should be family-friendly', () => {\n    /**\n     * Verifies all generated names meet family-friendly content requirements\n     */\n    for (let i = 0; i < 20; i++) {\n      const name = generateName();\n      expect(isContentFamilyFriendly(name)).toBe(true);\n    }\n  });\n\n  test('content filter should identify inappropriate words', () => {\n    /**\n     * Tests the family-friendly content filter with known inappropriate content\n     */\n    const inappropriateNames = [\n      'BadWord123',\n      'InappropriateContent',\n      'OffensiveTerm'\n    ];\n    \n    inappropriateNames.forEach(name => {\n      expect(isContentFamilyFriendly(name)).toBe(false);\n    });\n  });\n\n  test('content filter should approve appropriate words', () => {\n    /**\n     * Tests the family-friendly content filter with appropriate content\n     */\n    const appropriateNames = [\n      'HappySunshine',\n      'BrightMorning',\n      'GentleBreeze',\n      'CheerfulSong'\n    ];\n    \n    appropriateNames.forEach(name => {\n      expect(isContentFamilyFriendly(name)).toBe(true);\n    });\n  });\n\n  test('word pool should pass family-friendly validation', () => {\n    /**\n     * Ensures the entire word pool meets family-friendly requirements\n     */\n    const wordPool = getWordPool();\n    wordPool.forEach(word => {\n      expect(isContentFamilyFriendly(word)).toBe(true);\n    });\n  });\n});\n\ndescribe('Name Generator - Output Variety', () => {\n  test('should generate variety across large sample', () => {\n    /**\n     * Tests that generator produces sufficient variety across many calls\n     */\n    const sampleSize = 100;\n    const names = [];\n    \n    for (let i = 0; i < sampleSize; i++) {\n      names.push(generateName());\n    }\n    \