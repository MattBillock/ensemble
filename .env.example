# Ensemble Environment Configuration
# Copy to .env and fill in your values

# Required: Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Optional: Budget Tier (future feature)
# Options: full_firepower, balanced, economical
# ENSEMBLE_BUDGET_TIER=balanced

# Optional: Default Model (future feature)
# ENSEMBLE_DEFAULT_MODEL=claude-3-5-haiku-20241022

# Optional: Enable Performance Tracking (future feature)
# ENSEMBLE_TRACK_PERFORMANCE=true

# Optional: Cost Alerts (future feature)
# ENSEMBLE_COST_ALERT_THRESHOLD=10.00

# Optional: Always-On Mode (future feature)
# ENSEMBLE_WATCH_TASKS=true
# ENSEMBLE_TASK_FILE=tasks.json
# ENSEMBLE_CHECK_INTERVAL=60

# Optional: Logging Level
# ENSEMBLE_LOG_LEVEL=INFO

# Optional: Alternative LLM Provider (future feature)
# ENSEMBLE_LLM_PROVIDER=anthropic
# OPENAI_API_KEY=sk-xxxxxxxxxxxxx
